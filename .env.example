# Postgres
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# database package (Prisma 7 - used by prisma.config.ts)
DATABASE_URL=postgresql://taskflow:changeme@localhost:5432/taskflow?schema=taskflow

# apps/api
API_PORT=8000
API_LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# apps/web (NextAuth v4)
WEB_PORT=3000
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

METRICS_TOKEN=

RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="TaskFlow <onboarding@resend.dev>"

# Number of trusted reverse-proxy hops in front of apps/web for the ACTUAL
# deployment target - used to find the real client IP in X-Forwarded-For
# for auth rate-limiting. 1 covers a single PaaS edge (Railway, Vercel,
# Fly.io, Render, ...); raise it if a CDN/load balancer is chained in front
# of that edge, or set to 0 if this process is directly internet-facing.
TRUSTED_PROXY_HOPS=1
