# Postgres
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# database package (Prisma 7 - used by prisma.config.ts)
DATABASE_URL=postgresql://taskflow:changeme@localhost:5432/taskflow?schema=taskflow

# apps/api
# Only takes effect for a bare `pnpm --filter @taskflow/api dev`/`start`
# (server.ts's app.listen(env.API_PORT, ...)). Has NO effect under
# `docker compose up`: that container publishes no host port at all (only
# reachable through the nginx service below), and infrastructure/nginx/
# nginx.conf hardcodes its upstream at `api:8000` - change both together if
# you ever need this to differ from 8000 in Docker.
API_PORT=8000
API_LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# apps/web (NextAuth v4)
NEXTAUTH_SECRET=changeme-changeme-changeme-16-chars-min
NEXTAUTH_URL=http://localhost:3000
# Only needed when apps/api is deployed on a SIBLING subdomain of apps/web
# (e.g. web on taskflow.example.com, api on api.taskflow.example.com) - widens
# the session cookie's Domain attribute so api actually receives it. Leave
# unset for the docker-compose stack (single nginx origin, no subdomains).
# COOKIE_DOMAIN=.taskflow.example.com

# Read by apps/web/lib/env.ts's publicEnvSchema (NEXT_PUBLIC_API_URL) -
# backs both the tRPC client (lib/trpc/client.tsx, appends /trpc) and the
# Socket.IO client (lib/socket/client.ts). NEXT_PUBLIC_* vars are inlined at
# `next build` time, so in Docker these are build ARGs, not just runtime env
# - changing them requires rebuilding the web image, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Gates apps/api's /metrics scrape endpoint (see app.ts) - required in
# production (docker-compose.yml's api always runs NODE_ENV=production), so
# this has a real "changeme"-style default rather than being empty, same
# reasoning as NEXTAUTH_SECRET/INTERNAL_API_SECRET above: `docker compose up`
# must bring the whole stack - including a working Prometheus scrape and
# Grafana dashboard - to life out of the box. At least 16 characters.
# infrastructure/prometheus/prometheus.yml's bearer_token is a hardcoded
# literal (no env-var templating in the official Prometheus image) that
# MUST match this value - update both together if you change it.
METRICS_TOKEN=changeme-metrics-token-32-chars-min

# Grafana (infrastructure/grafana/) - dashboard at http://localhost/grafana/
# (routed through nginx, not its own published port - see nginx.conf),
# pre-provisioned with the Prometheus datasource + TaskFlow dashboard.
# GRAFANA_ADMIN_PASSWORD is Grafana's own admin login, unrelated to any
# secret above. Change it before any real deployment; set GRAFANA_ROOT_URL
# too if serving from a real domain instead of localhost.
# ROTATION GOTCHA: this only seeds the admin user the FIRST time Grafana
# initializes its own DB inside the grafana_data volume. Once that volume
# exists, Grafana ignores this var on every later restart - editing it here
# and restarting the container does NOT change an already-running admin's
# password. To actually rotate: `docker compose exec grafana grafana-cli
# admin reset-admin-password <new-password>` (or change it via the Grafana
# UI itself). The only way this var takes effect again is wiping the
# grafana_data volume (loses all dashboards/settings) for a clean reseed.
GRAFANA_ADMIN_PASSWORD=changeme
# GRAFANA_ROOT_URL=https://your-domain.example.com/grafana/
# CSRF check for POST /api/ds/query and the Grafana Live websocket - needs
# the request's Host explicitly listed (root_url alone isn't enough), or
# every dashboard panel fails with "origin not allowed" even though login
# (exempt from this check) works fine. Default covers local/demo; override
# for a real domain (host[:port], no scheme, comma-separated for more than
# one).
GRAFANA_CSRF_TRUSTED_ORIGINS=localhost
# GRAFANA_CSRF_TRUSTED_ORIGINS=your-domain.example.com

# Alertmanager (infrastructure/alertmanager/) - alerts UI at
# http://localhost/alertmanager/ (routed through nginx, like Grafana above).
# No real notification channel (Slack/email/PagerDuty) is wired up - see
# alertmanager.yml's docblock for how to add one once you have credentials.
# ALERTMANAGER_EXTERNAL_URL=https://your-domain.example.com/alertmanager/
# Alertmanager has no login of its own (unlike Grafana) - nginx enforces
# HTTP Basic auth in front of /alertmanager/ instead (see nginx.conf +
# docker-compose.yml's nginx service). Username is fixed ("admin"); change
# this password before any real deployment. Same rotation caveat as
# GRAFANA_ADMIN_PASSWORD does NOT apply here though - nginx regenerates
# /etc/nginx/.htpasswd from this var on every container start (it's not
# persisted to a volume), so editing this and restarting the nginx
# container DOES rotate it immediately.
ALERTMANAGER_ADMIN_PASSWORD=changeme

RESEND_API_KEY=re_xxxxxxxx
# Both apps/web and apps/api reject Resend's onboarding@resend.dev sandbox
# address whenever NODE_ENV=production (including docker-compose.yml's `web`
# and `api` services) - a deliberate fail-loud check for a *real* deploy that
# forgot to set this. This placeholder is a syntactically valid non-sandbox
# address so `docker compose up` boots out of the box for local dev/demo;
# replace it with a real verified sending domain before an actual
# production deployment (Railway/Vercel/etc. - see README).
EMAIL_FROM="TaskFlow <noreply@example.com>"

# Server-to-server secret gating apps/api's internalProcedure (e.g.
# auth.verifyCredentials, called by apps/web's server-side tRPC client, never
# by a browser). At least 32 characters. Generate with:
#   openssl rand -base64 32
INTERNAL_API_SECRET=changeme-internal-api-secret-32-chars-min

# Base URL apps/web's server-to-server tRPC client (lib/trpc/http-server.ts -
# login, verify-email) actually connects to. Deliberately separate from
# NEXT_PUBLIC_API_URL above (the BROWSER-facing origin): under
# docker-compose, a call made from INSIDE the `web` container has no reason
# to route back out through nginx, and "http://localhost" from inside that
# container means the web container itself (nothing listens on its port
# 80) - every login would otherwise fail to connect. Leave unset for a bare
# `pnpm dev` (falls back to NEXT_PUBLIC_API_URL, correct there since both
# processes share the same host). docker-compose.yml sets this explicitly
# to apps/api's internal address (http://api:8000).
# INTERNAL_API_URL=http://api:8000

# Number of trusted reverse-proxy hops for the ACTUAL deployment target -
# used to find the real client IP in X-Forwarded-For (auth rate-limiting in
# apps/web, express-rate-limit in apps/api). Read independently by both
# apps/web (lib/env.ts) and apps/api (config/env.ts) - keep them equal.
# 1 covers a single hop (nginx in the docker-compose stack below, or a
# single PaaS edge like Railway/Vercel/Fly.io/Render); raise it if another
# LB/CDN is chained in front of that hop, or set to 0 if directly
# internet-facing with no reverse proxy at all.
TRUSTED_PROXY_HOPS=1

# TTL (ms) for the in-process passwordChangedAt cache both apps/web
# (lib/auth/session-revocation.ts) and apps/api (utils/auth.ts) run
# independently - bounds how long a session issued before a password reset
# can still be accepted. Defaults to 60000 (60s) in both schemas if omitted;
# only playwright.config.ts overrides it (much lower) for E2E. Must be kept
# equal between apps/web and apps/api if you do set it - see either schema's
# field comment.
PASSWORD_CHANGED_AT_CACHE_TTL_MS=60000

# infrastructure/nginx - only used by `docker compose up` (see docker-compose.yml)
NGINX_PORT=80

# Never set ENABLE_TEST_ROUTES outside Playwright's own E2E run (it enables
# apps/api's /api/test/* routes - see apps/api/src/utils/e2e.ts). Leave
# it absent here and in every docker-compose service.
