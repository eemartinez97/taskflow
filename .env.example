# Postgres
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# database package (Prisma 7 - used by prisma.config.ts)
DATABASE_URL=postgresql://taskflow:changeme@localhost:5432/taskflow?schema=taskflow

# apps/api
# Only takes effect for a bare `pnpm --filter @taskflow/api dev`/`start`
# (server.ts's app.listen(env.API_PORT, ...)). Has NO effect under
# `docker compose up`: that container publishes no host port at all (only
# reachable through the nginx service below), and infrastructure/nginx/
# nginx.conf hardcodes its upstream at `api:8000` - change both together if
# you ever need this to differ from 8000 in Docker.
API_PORT=8000
API_LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# apps/web (NextAuth v4)
NEXTAUTH_SECRET=changeme-changeme-changeme-16-chars-min
NEXTAUTH_URL=http://localhost:3000
# Only needed when apps/api is deployed on a SIBLING subdomain of apps/web
# (e.g. web on taskflow.example.com, api on api.taskflow.example.com) - widens
# the session cookie's Domain attribute so api actually receives it. Leave
# unset for the docker-compose stack (single nginx origin, no subdomains).
# COOKIE_DOMAIN=.taskflow.example.com

# Read by apps/web/lib/env.ts's publicEnvSchema (NEXT_PUBLIC_API_URL) -
# backs both the tRPC client (lib/trpc/client.tsx, appends /trpc) and the
# Socket.IO client (lib/socket/client.ts). NEXT_PUBLIC_* vars are inlined at
# `next build` time, so in Docker these are build ARGs, not just runtime env
# - changing them requires rebuilding the web image, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

METRICS_TOKEN=

RESEND_API_KEY=re_xxxxxxxx
# Both apps/web and apps/api reject Resend's onboarding@resend.dev sandbox
# address whenever NODE_ENV=production (including docker-compose.yml's `web`
# and `api` services) - a deliberate fail-loud check for a *real* deploy that
# forgot to set this. This placeholder is a syntactically valid non-sandbox
# address so `docker compose up` boots out of the box for local dev/demo;
# replace it with a real verified sending domain before an actual
# production deployment (Railway/Vercel/etc. - see README).
EMAIL_FROM="TaskFlow <noreply@example.com>"

# Server-to-server secret gating apps/api's internalProcedure (e.g.
# auth.verifyCredentials, called by apps/web's server-side tRPC client, never
# by a browser). At least 32 characters. Generate with:
#   openssl rand -base64 32
INTERNAL_API_SECRET=changeme-internal-api-secret-32-chars-min

# Number of trusted reverse-proxy hops for the ACTUAL deployment target -
# used to find the real client IP in X-Forwarded-For (auth rate-limiting in
# apps/web, express-rate-limit in apps/api). Read independently by both
# apps/web (lib/env.ts) and apps/api (config/env.ts) - keep them equal.
# 1 covers a single hop (nginx in the docker-compose stack below, or a
# single PaaS edge like Railway/Vercel/Fly.io/Render); raise it if another
# LB/CDN is chained in front of that hop, or set to 0 if directly
# internet-facing with no reverse proxy at all.
TRUSTED_PROXY_HOPS=1

# TTL (ms) for the in-process passwordChangedAt cache both apps/web
# (lib/auth/session-revocation.ts) and apps/api (utils/auth.ts) run
# independently - bounds how long a session issued before a password reset
# can still be accepted. Defaults to 60000 (60s) in both schemas if omitted;
# only playwright.config.ts overrides it (much lower) for E2E. Must be kept
# equal between apps/web and apps/api if you do set it - see either schema's
# field comment.
PASSWORD_CHANGED_AT_CACHE_TTL_MS=60000

# infrastructure/nginx - only used by `docker compose up` (see docker-compose.yml)
NGINX_PORT=80

# Never set ENABLE_TEST_ROUTES outside Playwright's own E2E run (it enables
# apps/api's /api/test/* routes - see apps/api/src/utils/e2e.ts). Leave
# it absent here and in every docker-compose service.
