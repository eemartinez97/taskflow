# Same substitution mechanism as prometheus.yml.template (docker-compose.yml
# renders that one via sed at container startup) - this is the equivalent
# for docker-compose.monitoring.yml, which runs on a separate host from
# api/web. Only difference from the local
# template: the scrape target is api's PUBLIC domain over HTTPS instead of
# the internal docker network name, since prometheus lives on its own VM
# here, not alongside api in the same compose stack. __API_SCRAPE_TARGET__
# is substituted from the API_SCRAPE_TARGET env var (same mechanism as
# __METRICS_TOKEN__ below) so a domain change is a .env edit on the VM, not
# a code change/commit/merge.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alert-rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: taskflow-api
    scheme: https
    metrics_path: /metrics
    authorization:
      credentials: __METRICS_TOKEN__
    static_configs:
      - targets: ["__API_SCRAPE_TARGET__"]
