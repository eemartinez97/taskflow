# Template, not a live config - docker-compose.yml's prometheus service
# generates /etc/prometheus/prometheus.yml from this at container startup by
# substituting __METRICS_TOKEN__ with the real METRICS_TOKEN env var (sed,
# see that service's `command`). This is what keeps METRICS_TOKEN a SINGLE
# source of truth (the .env value) instead of a literal that had to be
# hand-copied here and kept in sync on every rotation - the official
# Prometheus image has no built-in env-var templating for its config file,
# so this project supplies its own minimal version of it.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alert-rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: taskflow-api
    scheme: http
    metrics_path: /metrics
    authorization:
      credentials: __METRICS_TOKEN__
    static_configs:
      - targets: ["api:8000"]
