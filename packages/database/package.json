{
  "name": "@taskflow/database",
  "version": "0.0.0",
  "description": "Prisma 7 schema, migrations, and PrismaClient singleton",
  "keywords": [],
  "author": "Erick Monjaras <osminerick@gmail.com>",
  "license": "ISC",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc",
    "build": "pnpm run db:generate && tsc",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "cleanup:abandoned-registrations": "tsx src/scripts/cleanup-abandoned-registrations.ts",
    "cleanup:expired-rate-limits": "tsx src/scripts/cleanup-expired-rate-limits.ts",
    "cleanup:stale-invitations": "tsx src/scripts/cleanup-stale-invitations.ts",
    "test": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:coverage": "vitest run --project=unit --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@prisma/config": "^7.8.0",
    "@taskflow/config": "workspace:*",
    "@taskflow/shared": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.7",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
