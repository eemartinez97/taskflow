// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["taskflow", "auth"]
  // multiSchema is stable since Prisma 5 - no previewFeatures needed
}

// Enums

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@schema("taskflow")
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT

  @@schema("taskflow")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED

  @@schema("taskflow")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  COMMENT_CREATED
  MEMBER_INVITED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  MEMBER_LEFT

  @@schema("taskflow")
}

/**
 * No EXPIRED member - expiry is derived from `expiresAt` at read time,
 * exactly like AuthToken's `findValidAuthToken`. A stored EXPIRED status
 * would need a cron to stay truthful; deriving it means a row is always
 * consistent with `now()` no matter how long it sits unread.
 */
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED

  @@schema("taskflow")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@schema("auth")
}

// Auth tables (managed by @auth/prisma-adapter)

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  // Set on every successful password reset (see consumeTokenAndResetPassword).
  // apps/api's getSessionUser checks this against the JWT's `iat` claim (via
  // a short-TTL cache) to reject sessions issued before the most recent
  // reset - so a stolen session cookie doesn't survive its own victim's
  // reset indefinitely.
  passwordChangedAt DateTime?
  // Throttled write (see getSessionUser in apps/api/src/utils/auth.ts) -
  // updated at most once per ACTIVE_USER_LASTSEEN_THROTTLE_MS per user, not
  // on every request. Backs the activeUsersTotal Prometheus gauge
  // (apps/api/src/metrics/db-gauges.ts) - a DAU-style "seen in the last
  // 24h" count, distinct from socketConnectedClients' concurrently-online
  // count.
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  authTokens AuthToken[]

  // Application relations
  memberships            Membership[]
  assignedTasks          Task[]         @relation("TaskAssignee")
  createdTasks           Task[]         @relation("TaskCreator")
  comments               Comment[]
  notifications          Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  sentInvitations        Invitation[]   @relation("InvitationInviter")

  @@schema("auth")
}

/**
 * Single-use tokens for email verification (registration step 2) and
 * password reset. The raw token is NEVER persisted - only its SHA-256 hash,
 * so a DB leak alone cannot be used to hijack an account.
 */
model AuthToken {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique
  expiresAt  DateTime
  // null = still active. Set once the token is used (registration completed
  // or password actually reset) so it can never be replayed.
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Used both to look up "does this user have an active token of this type"
  // (resend / rate-limit logic) and for periodic cleanup of expired rows.
  @@index([userId, type])
  @@schema("auth")
}

/**
 * Generic per-key sliding-window rate-limit counter, backed by Postgres so
 * the count is shared across every apps/web instance (see
 * apps/web/lib/auth/rate-limit.ts) - an in-memory/globalThis counter would
 * otherwise reset on every redeploy and fragment independently per replica
 * under horizontal scaling, silently multiplying the effective limit.
 */
model RateLimitBucket {
  /** Caller-defined key, e.g. a normalized email address. */
  key     String   @id
  count   Int
  resetAt DateTime

  // Used by the cleanup script to find long-expired rows worth deleting.
  @@index([resetAt])
  @@schema("auth")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("auth")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("auth")
}

// Application tables

model Org {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  projects    Project[]
  labels      Label[]
  invitations Invitation[]

  @@schema("taskflow")
}

model Membership {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @db.Uuid
  userId        String   @db.Uuid
  role          Role     @default(MEMBER)
  cursorsHidden Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId, orgId])
  @@schema("taskflow")
}

model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid
  name        String   @db.VarChar(100)
  key         String   @db.VarChar(10)
  slug        String   @db.VarChar(50)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org    Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boards Board[]

  @@unique([orgId, key])
  @@unique([orgId, slug])
  @@index([orgId])
  @@schema("taskflow")
}

model Board {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns Column[]

  @@index([projectId])
  @@schema("taskflow")
}

model Column {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String   @db.Uuid
  name      String   @db.VarChar(100)
  // Fractional float for O(1) lexorank-style reordering
  position  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
  @@schema("taskflow")
}

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  columnId    String       @db.Uuid
  title       String       @db.VarChar(255)
  description String?      @db.VarChar(10000)
  assigneeId  String?      @db.Uuid
  creatorId   String?      @db.Uuid
  priority    TaskPriority @default(NONE)
  status      TaskStatus   @default(TODO)
  // Fractional float for O(1) lexorank-style reordering within column
  position    Float
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User?  @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  comments    Comment[]
  attachments Attachment[]
  taskLabels  TaskLabel[]

  @@index([columnId, position])
  @@index([assigneeId])
  @@schema("taskflow")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String   @db.VarChar(5000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@schema("taskflow")
}

model Label {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @db.Uuid
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tasks TaskLabel[]

  @@unique([orgId, name])
  @@schema("taskflow")
}

model TaskLabel {
  taskId  String @db.Uuid
  labelId String @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@schema("taskflow")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String           @db.Uuid
  actorId    String?          @db.Uuid
  type       NotificationType
  message    String           @db.VarChar(500)
  read       Boolean          @default(false)
  entityId   String?          @db.Uuid
  entityType String?          @db.VarChar(50)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Recipient
  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // Who triggered the notification (nullable - system events have no actor)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@schema("taskflow")
}

model Attachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @db.Uuid
  fileUrl   String
  fileName  String   @db.VarChar(255)
  fileSize  Int
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@schema("taskflow")
}

/**
 * A pending (or resolved) org invitation. `Membership` is created only on
 * accept - never at invite time - so an invitee's consent is required
 * before they join. The raw token is NEVER persisted, only its SHA-256
 * hash (`tokenHash`), same rationale as AuthToken.
 *
 * `@@unique([orgId, email])` is the whole re-invite story: re-inviting the
 * same address is a single atomic upsert on this constraint (see
 * apps/api's `upsertInvitation`), never a second row - a DECLINED/REVOKED/
 * expired invitation is resurrected in place with a fresh token and expiry.
 *
 * The `role <> 'OWNER'` constraint (PSL can't express "any Role except
 * one value") is added by hand in the migration - see that migration file.
 */
model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String           @db.Uuid
  // Always lowercase - normalized at the Zod boundary (emailField()) before
  // it ever reaches this column, which is what makes the unique constraint
  // below mean what it looks like it means.
  email       String           @db.VarChar(255)
  role        Role             @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  tokenHash   String           @unique
  invitedById String?          @db.Uuid
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([orgId, email])
  @@index([email, status])
  @@index([orgId, status])
  @@schema("taskflow")
}
