    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "prettier": "^3.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
