{
  "name": "@taskflow/shared",
  "version": "0.0.0",
  "description": "Shared Zod schemas, domain types, and constants",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./types": "./src/types/index.ts",
    "./constants": "./src/constants/index.ts"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@taskflow/config": "workspace:*",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "zod": "^4.4.3"
  }
}
